POSTGRES_DB=mavi_connect
POSTGRES_USER=mavi
POSTGRES_PASSWORD=mavi
DATABASE_URL=postgresql://mavi:mavi@database:5432/mavi_connect
API_URL=http://api:8000
APP_TIME_ZONE=America/Sao_Paulo
EMPLOYEE_SESSION_TTL_HOURS=12

# Local (default): images are persisted in the Docker volume media-data.
STORAGE_BACKEND=local
STORAGE_BUCKET=dish-images
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
ASAAS_API_KEY='replace_with_sandbox_api_key'
ASAAS_WEBHOOK_TOKEN=replace_with_a_random_secret_of_at_least_32_chars
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_REQUEST_TIMEOUT_SECONDS=10
ASAAS_USER_AGENT=mavi-connect/0.1.0
PAYMENT_WORKER_INTERVAL_SECONDS=15

