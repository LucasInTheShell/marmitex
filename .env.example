POSTGRES_DB=mavi_connect
POSTGRES_USER=mavi
POSTGRES_PASSWORD=mavi
DATABASE_URL=postgresql://mavi:mavi@database:5432/mavi_connect
API_URL=http://api:8000
APP_TIME_ZONE=America/Sao_Paulo
EMPLOYEE_SESSION_TTL_HOURS=12

# Local (default): images are persisted in the Docker volume media-data.
STORAGE_BACKEND=local
STORAGE_BUCKET=dish-images
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

